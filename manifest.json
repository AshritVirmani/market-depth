{
  "manifest_version": 3,
  "name": "Dhan 2.0",
  "version": "2.0",
  "description": "Scrapes and downloads market depth data from Dhan DOM.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tv.dhan.co/*",
        "https://web.dhan.co/*",
        "https://*.dhan.co/*"
      ],
      "js": [
        "dist/content.js"
      ]
    }
  ]
}